# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore y NUNCA debe commitearse.
#
# En producción, estos valores se cargan con:
#   supabase secrets set NOMBRE=valor

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (https://aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Límites del tier gratuito. Se ajustan si el proveedor los cambia.
GEMINI_MAX_REQUESTS_PER_MINUTE=15
GEMINI_MAX_REQUESTS_PER_DAY=1500

# --- Telegram (crear el bot con @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_TRAINER_CHAT_ID=
# Cadena aleatoria propia, para verificar los webhooks entrantes de Telegram
TELEGRAM_WEBHOOK_SECRET=

# --- Tally ---
TALLY_WEBHOOK_SECRET=

# --- Tests de integración (solo local) ---
# Base de administración usada para recrear la base de tests en cada ejecución.
# No es un secreto: son credenciales de un PostgreSQL local de desarrollo.
TEST_ADMIN_DATABASE_URL=postgresql://trainerflow:trainerflow@127.0.0.1:5432/postgres
TEST_DATABASE_NAME=trainerflow_test
