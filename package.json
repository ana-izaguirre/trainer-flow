{
  "name": "trainer-flow",
  "version": "0.1.0",
  "description": "Automatización de rutinas para entrenadores personales, con revisión humana obligatoria",
  "license": "ISC",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test:run && pnpm test:integration",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "types": "supabase gen types typescript --linked > supabase/functions/_core/database.types.ts",
    "types:local": "supabase gen types typescript --schema public --db-url postgresql://postgres:postgres@127.0.0.1:5432/trainerflow_test > supabase/functions/_core/database.types.ts",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "lint:fix": "oxlint --fix",
    "deno:check": "deno check --config supabase/functions/deno.json $(find supabase/functions -name \"*.ts\" ! \\( -path \"*/_core/*\" -name \"*.test.ts\" \\))",
    "deno:lint": "deno lint --config supabase/functions/deno.json supabase/functions",
    "test:e2e": "vitest run --config vitest.integration.config.ts tests/e2e",
    "test:mutation": "stryker run",
    "dev:tunnel": "bash scripts/dev-tunnel.sh",
    "deno:test": "deno test --allow-env --config supabase/functions/deno.json supabase/functions"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^2.1.8",
    "deno": "^2.9.6",
    "oxlint": "^1.83.0",
    "pg": "^8.23.0",
    "supabase": "^2.117.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "deno"
    ]
  }
}
