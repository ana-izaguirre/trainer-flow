{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],

    // Los imports dentro de supabase/functions/ llevan extensión .ts porque
    // Deno lo exige. Esto permite que TypeScript y Vitest los entiendan igual.
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // Tipado estricto. Sin any.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "sourceMap": true
  },
  // Node comprueba SOLO el dominio y los tests. `_shared/` y los handlers
  // corren en Deno, usan `Deno.env`, `fetch` e imports `npm:`, y los verifica
  // `pnpm deno:check` con el compilador de Deno.
  "include": [
    "supabase/functions/_core/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
